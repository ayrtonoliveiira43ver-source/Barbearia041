rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signedIn(){return request.auth != null;}
 function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;}
 match /admins/{id}{allow read: if signedIn() && request.auth.uid == id; allow write: if false;}
 match /public/{id}{allow read: if true; allow write: if isAdmin();}
 match /services/{id}{allow read: if true; allow write: if isAdmin();}
 match /promos/{id}{allow read: if true; allow write: if isAdmin();}
 match /vouchers/{id}{allow read: if true; allow write: if isAdmin();}
 match /media/{id}{allow read: if isAdmin() || resource.data.approved == true || resource.data.approved == 'true'; allow write: if isAdmin();}
 match /customers/{id}{allow read: if isAdmin() || (signedIn() && request.auth.uid == id); allow create: if isAdmin() || (signedIn() && request.auth.uid == id && !('stamps' in request.resource.data)); allow update: if isAdmin() || (signedIn() && request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','updatedAt','mediaConsent','consentUpdatedAt'])); allow delete: if isAdmin();}
}}
