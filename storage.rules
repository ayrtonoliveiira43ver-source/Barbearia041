rules_version = '2';
service firebase.storage {match /b/{bucket}/o {match /gallery/{uid}/{file}{allow read: if true;allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('image/.*|video/.*');}}}
